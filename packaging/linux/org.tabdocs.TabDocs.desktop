[Desktop Entry]
Type=Application
Name=TabDocs
GenericName=Word Processor
Comment=Write and design documents; open and save Word files
Exec=tabdocs %F
TryExec=tabdocs
Icon=org.tabdocs.TabDocs
Terminal=false
StartupNotify=true
StartupWMClass=org.tabdocs.TabDocs
Categories=Office;WordProcessor;
Keywords=word;processor;document;docx;writer;text;letter;report;
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.oasis.opendocument.text;application/rtf;text/markdown;text/x-tex;text/html;text/plain;
